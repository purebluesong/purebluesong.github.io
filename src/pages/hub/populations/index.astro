---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import data from '../../../data/populations.json';

const pageTitle = `人群分析 · ${SITE_TITLE}`;
const pageDescription = data.meta.subtitle;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="pop-page">
			<section class="hero">
				<p class="crumb">
					<a href="/hub/">信息整合</a>
					<span aria-hidden="true"> / </span>
					<span>人群分析</span>
				</p>
				<p class="brand-mark">{SITE_TITLE}</p>
				<h1 class="reveal">人群分析</h1>
				<p class="lede reveal delay-1">{data.meta.subtitle}</p>
				<p class="note reveal delay-2">{data.meta.disclaimer}</p>
			</section>

			<section class="explorer reveal delay-2" id="populations-explorer" aria-label="平行坐标人群探索器">
				<div class="toolbar">
					<div class="count" id="result-count" aria-live="polite"></div>
					<button type="button" class="reset" id="reset-view" hidden>重置选中</button>
				</div>

				<p class="chart-hint" id="brush-hint">
					主视图为平行坐标：每条竖轴是一个垂直维度，每条折线是一个人群框架；线越粗/越实，示意规模越大。
				</p>

				<div
					id="parallel-chart"
					class="parallel-chart"
					role="img"
					aria-label="人群框架平行坐标图"
				>
				</div>

				<div class="detail-panel" id="crowd-detail" aria-live="polite"></div>

				<section class="radar-wrap" id="radar-wrap" hidden aria-label="雷达对照">
					<p class="aside-label">雷达对照</p>
					<p class="radar-note">把 1–2 个人群框架加入对照，比较它们在各维度上的相对档位。</p>
					<div id="radar-chart" class="radar-chart"></div>
				</section>

				<details class="legend">
					<summary>维度说明与舍弃项</summary>
					<ul class="dim-legend">
						{
							data.dimensions.map((dim) => (
								<li>
									<strong>{dim.label}</strong>
									<span> — {dim.whySeparable}</span>
								</li>
							))
						}
					</ul>
					<p class="aside-label nested-title">未单列为主轴</p>
					<ul class="dim-legend">
						{
							data.droppedOrNested.map((item) => (
								<li>
									<strong>{item.label}</strong>
									<span>
										{' '}
										（{item.action === 'nest' ? `归入 ${item.nestUnder}` : '舍弃'}）— {item.reason}
									</span>
								</li>
							))
						}
					</ul>
				</details>
			</section>
		</main>
		<Footer />

		<script id="populations-data" type="application/json" set:html={JSON.stringify(data)} />
		<script>
			const raw = document.getElementById('populations-data')?.textContent ?? '{}';
			const payload = JSON.parse(raw);
			const root = document.getElementById('populations-explorer');
			if (root) {
				const { mountPopulationsExplorer } = await import('../../../scripts/populations-explorer');
				mountPopulationsExplorer(root, payload);
			}
		</script>
	</body>
</html>

<style>
	.pop-page {
		width: min(1120px, calc(100% - 2em));
		margin: auto;
		padding: 2.25rem 0 3.5rem;
	}

	.hero {
		max-width: 40rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgba(90, 112, 138, 0.16);
		margin-bottom: 1.75rem;
	}

	.crumb {
		margin: 0 0 1rem;
		font-size: 0.92rem;
		color: rgb(var(--gray));
	}
	.crumb a {
		text-decoration: none;
	}

	.brand-mark {
		margin: 0 0 0.85rem;
		font-family: var(--font-display), sans-serif;
		font-size: clamp(2.1rem, 6vw, 3.2rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.95;
		color: var(--ink);
		animation: rise 0.85s ease both;
	}

	.hero h1 {
		margin: 0 0 0.7rem;
		font-size: clamp(1.45rem, 3.2vw, 1.9rem);
		font-weight: 600;
		color: var(--ink-soft);
	}

	.lede {
		margin: 0 0 0.85rem;
		max-width: 36ch;
		color: rgb(var(--gray));
		font-size: 1.08rem;
	}

	.note {
		margin: 0;
		max-width: 46ch;
		font-size: 0.95rem;
		color: var(--foam-deep);
		border-left: 3px solid var(--foam);
		padding-left: 0.85rem;
	}

	.toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.65rem;
	}

	.count {
		font-family: var(--font-display), sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--ink);
		letter-spacing: -0.01em;
	}

	.reset,
	.action {
		appearance: none;
		border: 1px solid rgba(28, 45, 69, 0.22);
		background: transparent;
		color: var(--ink-soft);
		font: inherit;
		font-size: 0.9rem;
		padding: 0.35rem 0.75rem;
		border-radius: 4px;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}
	.reset:hover,
	.action:hover:not(:disabled) {
		border-color: var(--foam);
		color: var(--foam-deep);
		transform: translateY(-1px);
	}
	.action:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}
	.action:not(.ghost) {
		background: rgba(47, 143, 157, 0.1);
		border-color: rgba(47, 143, 157, 0.35);
		color: var(--foam-deep);
	}

	.chart-hint {
		margin: 0 0 0.85rem;
		max-width: 62ch;
		font-size: 0.95rem;
		color: rgb(var(--gray));
	}

	.parallel-chart {
		width: 100%;
		height: min(520px, 68vh);
		min-height: 320px;
		border-top: 1px solid rgba(90, 112, 138, 0.14);
		border-bottom: 1px solid rgba(90, 112, 138, 0.14);
		background:
			linear-gradient(180deg, rgba(244, 248, 251, 0.55), rgba(232, 240, 246, 0.25));
	}

	.detail-panel {
		margin-top: 1.35rem;
		padding: 1.1rem 0 0.25rem;
		border-top: 1px solid rgba(90, 112, 138, 0.12);
		min-height: 7rem;
	}

	.detail-empty,
	.detail-tip,
	.radar-note,
	.summary,
	.estimate {
		color: rgb(var(--gray));
		font-size: 0.98rem;
	}
	.detail-empty {
		margin: 0 0 0.45rem;
	}
	.detail-tip {
		margin: 0;
		font-size: 0.9rem;
	}

	.detail-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.55rem 0.85rem;
		margin-bottom: 0.35rem;
	}
	.tone {
		font-family: var(--font-display), sans-serif;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--foam-deep);
	}
	.detail-panel h2 {
		margin: 0;
		font-size: 1.25rem;
		color: var(--ink);
	}
	.summary {
		margin: 0 0 0.55rem;
		max-width: 52ch;
	}
	.estimate {
		margin: 0 0 0.85rem;
		font-size: 0.9rem;
	}
	.estimate strong {
		color: var(--ink-soft);
		font-family: var(--font-display), sans-serif;
	}

	.facets {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.95rem;
	}
	.facet {
		display: inline-flex;
		gap: 0.3rem;
		align-items: baseline;
		font-size: 0.82rem;
		color: var(--ink-soft);
		border-bottom: 1px dashed rgba(47, 143, 157, 0.35);
		padding-bottom: 0.05rem;
	}
	.facet em {
		font-style: normal;
		color: rgb(var(--gray));
		font-size: 0.75rem;
	}

	.detail-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.aside-label {
		margin: 0 0 0.55rem;
		font-family: var(--font-display), sans-serif;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--foam-deep);
	}

	.radar-wrap {
		margin-top: 1.75rem;
		padding-top: 1.1rem;
		border-top: 1px solid rgba(90, 112, 138, 0.14);
	}
	.radar-note {
		margin: 0 0 0.5rem;
		font-size: 0.92rem;
	}
	.radar-chart {
		width: 100%;
		height: min(360px, 55vh);
		min-height: 260px;
	}

	.legend {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(90, 112, 138, 0.16);
	}
	.legend summary {
		cursor: pointer;
		font-family: var(--font-display), sans-serif;
		font-weight: 700;
		color: var(--ink);
	}
	.dim-legend {
		margin: 0.85rem 0 0;
		padding-left: 1.1rem;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.dim-legend strong {
		color: var(--ink-soft);
	}
	.nested-title {
		margin-top: 1.25rem;
	}

	.reveal {
		opacity: 0;
		transform: translateY(12px);
		animation: rise 0.85s ease both;
	}
	.delay-1 {
		animation-delay: 0.12s;
	}
	.delay-2 {
		animation-delay: 0.24s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 720px) {
		.parallel-chart {
			height: 360px;
			min-height: 300px;
		}
		.radar-chart {
			height: 300px;
			min-height: 240px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-mark,
		.reveal {
			animation: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
	}
</style>
