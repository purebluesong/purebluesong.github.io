---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import data from '../../../data/populations.json';

const pageTitle = `人群分析 · ${SITE_TITLE}`;
const pageDescription = data.meta.subtitle;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
	</head>
	<body>
		<Header />
		<main class="pop-page">
			<section class="hero">
				<p class="crumb">
					<a href="/hub/">信息整合</a>
					<span aria-hidden="true"> / </span>
					<span>人群分析</span>
				</p>
				<p class="brand-mark">{SITE_TITLE}</p>
				<h1 class="reveal">人群分析</h1>
				<p class="lede reveal delay-1">{data.meta.subtitle}</p>
				<p class="note reveal delay-2">{data.meta.disclaimer}</p>
			</section>

			<section class="explorer" aria-label="人群探索器">
				<div class="toolbar reveal delay-2">
					<div class="count" id="result-count" aria-live="polite"></div>
					<button type="button" class="reset" id="reset-filters" hidden>清空筛选</button>
				</div>

				<div class="layout">
					<aside class="filters" aria-label="维度筛选">
						<p class="aside-label">垂直维度</p>
						{
							data.dimensions.map((dim) => (
								<details class="dim" data-dim={dim.id} open>
									<summary>
										<span class="dim-label">{dim.label}</span>
										<span class="dim-active" data-active-for={dim.id} hidden></span>
									</summary>
									<p class="dim-def">{dim.definition}</p>
									<div class="buckets" role="group" aria-label={`${dim.label} 取值`}>
										{dim.buckets.map((bucket) => (
											<label class="chip">
												<input
													type="checkbox"
													name={dim.id}
													value={bucket.id}
													data-dim={dim.id}
												/>
												<span>{bucket.label}</span>
											</label>
										))}
									</div>
									<p class="caveat">相关提醒：{dim.correlationCaveats}</p>
								</details>
							))
						}
					</aside>

					<div class="stage">
						<section class="matrix-wrap" aria-label="维度轮廓">
							<p class="aside-label">示例轮廓</p>
							<div class="matrix" id="parallel" role="img" aria-label="人群在各维度上的取值轮廓"></div>
						</section>

						<section class="results" aria-label="匹配人群">
							<ul id="profile-list"></ul>
							<p class="empty" id="empty-state" hidden>没有同时满足当前筛选的示例框架。试着少选几项。</p>
						</section>

						<details class="legend">
							<summary>维度说明与舍弃项</summary>
							<ul class="dim-legend">
								{
									data.dimensions.map((dim) => (
										<li>
											<strong>{dim.label}</strong>
											<span> — {dim.whySeparable}</span>
										</li>
									))
								}
							</ul>
							<p class="aside-label nested-title">未单列为主轴</p>
							<ul class="dim-legend">
								{
									data.droppedOrNested.map((item) => (
										<li>
											<strong>{item.label}</strong>
											<span>
												{' '}
												（{item.action === 'nest' ? `归入 ${item.nestUnder}` : '舍弃'}）—{' '}
												{item.reason}
											</span>
										</li>
									))
								}
							</ul>
						</details>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script id="populations-data" type="application/json" set:html={JSON.stringify(data)} />
		<script>
			type Dim = {
				id: string;
				label: string;
				buckets: { id: string; label: string }[];
			};
			type Profile = {
				id: string;
				title: string;
				summary: string;
				tone: string;
				traits: Record<string, string>;
			};
			type Payload = {
				dimensions: Dim[];
				profiles: Profile[];
			};

			const raw = document.getElementById('populations-data')?.textContent ?? '{}';
			const payload = JSON.parse(raw) as Payload;
			const dimensions = payload.dimensions;
			const profiles = payload.profiles;
			const dimMap = Object.fromEntries(dimensions.map((d) => [d.id, d]));

			const listEl = document.getElementById('profile-list')!;
			const emptyEl = document.getElementById('empty-state')!;
			const countEl = document.getElementById('result-count')!;
			const resetBtn = document.getElementById('reset-filters') as HTMLButtonElement;
			const parallelEl = document.getElementById('parallel')!;
			const inputs = [...document.querySelectorAll<HTMLInputElement>('.chip input')];

			function selectedFilters() {
				const out: Record<string, string[]> = {};
				for (const input of inputs) {
					if (!input.checked) continue;
					const dim = input.dataset.dim!;
					(out[dim] ||= []).push(input.value);
				}
				return out;
			}

			function matches(profile: Profile, filters: Record<string, string[]>) {
				return Object.entries(filters).every(([dim, values]) => {
					if (!values.length) return true;
					return values.includes(profile.traits[dim]);
				});
			}

			function bucketLabel(dimId: string, bucketId: string) {
				const dim = dimMap[dimId];
				return dim?.buckets.find((b) => b.id === bucketId)?.label ?? bucketId;
			}

			function renderProfiles(active: Profile[]) {
				listEl.innerHTML = '';
				active.forEach((profile, index) => {
					const li = document.createElement('li');
					li.className = 'profile';
					li.style.setProperty('--i', String(index));

					const chips = dimensions
						.map((dim) => {
							const value = profile.traits[dim.id];
							return `<span class="facet"><em>${dim.label}</em>${bucketLabel(dim.id, value)}</span>`;
						})
						.join('');

					li.innerHTML = `
						<div class="profile-head">
							<span class="tone">${profile.tone}</span>
							<h2>${profile.title}</h2>
						</div>
						<p class="summary">${profile.summary}</p>
						<div class="facets">${chips}</div>
					`;
					listEl.appendChild(li);
				});
			}

			function renderParallel(active: Profile[]) {
				const width = Math.max(parallelEl.clientWidth || 640, 320);
				const height = 168;
				const padX = 18;
				const padY = 22;
				const n = dimensions.length;
				const xAt = (i: number) => padX + (i * (width - padX * 2)) / Math.max(n - 1, 1);

				const axisLines = dimensions
					.map((dim, i) => {
						const x = xAt(i);
						return `<line class="axis" x1="${x}" y1="${padY}" x2="${x}" y2="${height - padY}" />
							<text class="axis-label" x="${x}" y="${height - 4}" text-anchor="middle">${dim.label}</text>`;
					})
					.join('');

				const paths = active
					.map((profile, idx) => {
						const points = dimensions
							.map((dim, i) => {
								const buckets = dim.buckets;
								const bi = Math.max(
									0,
									buckets.findIndex((b) => b.id === profile.traits[dim.id]),
								);
								const t = buckets.length <= 1 ? 0.5 : bi / (buckets.length - 1);
								const y = padY + t * (height - padY * 2);
								return `${xAt(i)},${y}`;
							})
							.join(' ');
						return `<polyline class="trace t${idx % 5}" points="${points}" />`;
					})
					.join('');

				parallelEl.innerHTML = `<svg viewBox="0 0 ${width} ${height}" width="100%" height="${height}" preserveAspectRatio="none">${axisLines}${paths}</svg>`;
			}

			function syncActiveBadges(filters: Record<string, string[]>) {
				for (const dim of dimensions) {
					const badge = document.querySelector(`[data-active-for="${dim.id}"]`) as HTMLElement | null;
					const n = filters[dim.id]?.length ?? 0;
					if (!badge) continue;
					if (n) {
						badge.hidden = false;
						badge.textContent = String(n);
					} else {
						badge.hidden = true;
						badge.textContent = '';
					}
				}
			}

			function update() {
				const filters = selectedFilters();
				const active = profiles.filter((p) => matches(p, filters));
				const filterCount = Object.values(filters).reduce((n, arr) => n + arr.length, 0);

				countEl.textContent = filterCount
					? `匹配 ${active.length} / ${profiles.length} 个示例框架`
					: `${profiles.length} 个示例框架 · 点选左侧维度切分`;
				resetBtn.hidden = filterCount === 0;
				emptyEl.hidden = active.length > 0;
				syncActiveBadges(filters);
				renderProfiles(active);
				renderParallel(active);
			}

			for (const input of inputs) {
				input.addEventListener('change', update);
			}
			resetBtn.addEventListener('click', () => {
				for (const input of inputs) input.checked = false;
				update();
			});
			window.addEventListener('resize', () => {
				renderParallel(profiles.filter((p) => matches(p, selectedFilters())));
			});
			update();
		</script>
	</body>
</html>

<style>
	.pop-page {
		width: min(1100px, calc(100% - 2em));
		margin: auto;
		padding: 2.25rem 0 3.5rem;
	}

	.hero {
		max-width: 40rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid rgba(90, 112, 138, 0.16);
		margin-bottom: 1.75rem;
	}

	.crumb {
		margin: 0 0 1rem;
		font-size: 0.92rem;
		color: rgb(var(--gray));
	}
	.crumb a {
		text-decoration: none;
	}

	.brand-mark {
		margin: 0 0 0.85rem;
		font-family: var(--font-display), sans-serif;
		font-size: clamp(2.1rem, 6vw, 3.2rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 0.95;
		color: var(--ink);
		animation: rise 0.85s ease both;
	}

	.hero h1 {
		margin: 0 0 0.7rem;
		font-size: clamp(1.45rem, 3.2vw, 1.9rem);
		font-weight: 600;
		color: var(--ink-soft);
	}

	.lede {
		margin: 0 0 0.85rem;
		max-width: 36ch;
		color: rgb(var(--gray));
		font-size: 1.08rem;
	}

	.note {
		margin: 0;
		max-width: 46ch;
		font-size: 0.95rem;
		color: var(--foam-deep);
		border-left: 3px solid var(--foam);
		padding-left: 0.85rem;
	}

	.toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.1rem;
	}

	.count {
		font-family: var(--font-display), sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--ink);
		letter-spacing: -0.01em;
	}

	.reset {
		appearance: none;
		border: 1px solid rgba(28, 45, 69, 0.22);
		background: transparent;
		color: var(--ink-soft);
		font: inherit;
		font-size: 0.9rem;
		padding: 0.35rem 0.75rem;
		border-radius: 4px;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			transform 0.2s ease;
	}
	.reset:hover {
		border-color: var(--foam);
		color: var(--foam-deep);
		transform: translateY(-1px);
	}

	.layout {
		display: grid;
		grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
		gap: 1.75rem;
		align-items: start;
	}

	.aside-label {
		margin: 0 0 0.75rem;
		font-family: var(--font-display), sans-serif;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--foam-deep);
	}

	.filters {
		position: sticky;
		top: 4.25rem;
		max-height: calc(100vh - 5rem);
		overflow: auto;
		padding-right: 0.35rem;
	}

	.dim {
		border-bottom: 1px solid rgba(90, 112, 138, 0.14);
		padding: 0.55rem 0 0.75rem;
	}
	.dim summary {
		cursor: pointer;
		list-style: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		font-family: var(--font-display), sans-serif;
		font-weight: 700;
		color: var(--ink);
		letter-spacing: -0.02em;
	}
	.dim summary::-webkit-details-marker {
		display: none;
	}
	.dim-active {
		min-width: 1.25rem;
		height: 1.25rem;
		padding: 0 0.35rem;
		border-radius: 999px;
		background: var(--ink);
		color: #f4f8fb;
		font-size: 0.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.dim-def {
		margin: 0.45rem 0 0.65rem;
		font-size: 0.92rem;
		color: rgb(var(--gray));
		line-height: 1.55;
	}
	.caveat {
		margin: 0.65rem 0 0;
		font-size: 0.82rem;
		color: rgba(90, 112, 138, 0.95);
		line-height: 1.45;
	}

	.buckets {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.28rem 0.65rem;
		border: 1px solid rgba(28, 45, 69, 0.18);
		border-radius: 999px;
		font-size: 0.86rem;
		cursor: pointer;
		user-select: none;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease,
			transform 0.18s ease;
	}
	.chip:hover {
		border-color: var(--foam);
		transform: translateY(-1px);
	}
	.chip:has(input:checked) {
		background: rgba(47, 143, 157, 0.14);
		border-color: var(--foam-deep);
		color: var(--foam-deep);
	}
	.chip input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.matrix-wrap {
		margin-bottom: 1.5rem;
	}
	.matrix {
		width: 100%;
		min-height: 168px;
		border-top: 1px solid rgba(90, 112, 138, 0.14);
		border-bottom: 1px solid rgba(90, 112, 138, 0.14);
		padding: 0.35rem 0;
	}
	.matrix :global(svg) {
		display: block;
		overflow: visible;
	}
	.matrix :global(.axis) {
		stroke: rgba(90, 112, 138, 0.28);
		stroke-width: 1;
	}
	.matrix :global(.axis-label) {
		fill: rgb(var(--gray));
		font-size: 9px;
		font-family: var(--font-display), sans-serif;
	}
	.matrix :global(.trace) {
		fill: none;
		stroke-width: 1.6;
		stroke-linejoin: round;
		stroke-linecap: round;
		opacity: 0.78;
		animation: draw-in 0.7s ease both;
	}
	.matrix :global(.t0) {
		stroke: #1f6b76;
	}
	.matrix :global(.t1) {
		stroke: #4a7ea8;
	}
	.matrix :global(.t2) {
		stroke: #0a1628;
	}
	.matrix :global(.t3) {
		stroke: #2f8f9d;
	}
	.matrix :global(.t4) {
		stroke: #6b8cae;
	}

	#profile-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.profile {
		padding: 1.15rem 0;
		border-bottom: 1px solid rgba(90, 112, 138, 0.14);
		animation: rise 0.55s ease both;
		animation-delay: calc(var(--i, 0) * 0.04s);
	}
	.profile-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.55rem 0.85rem;
		margin-bottom: 0.35rem;
	}
	.tone {
		font-family: var(--font-display), sans-serif;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--foam-deep);
	}
	.profile h2 {
		margin: 0;
		font-size: 1.2rem;
	}
	.summary {
		margin: 0 0 0.75rem;
		color: rgb(var(--gray));
		font-size: 0.98rem;
		max-width: 48ch;
	}
	.facets {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.facet {
		display: inline-flex;
		gap: 0.3rem;
		align-items: baseline;
		font-size: 0.82rem;
		color: var(--ink-soft);
		border-bottom: 1px dashed rgba(47, 143, 157, 0.35);
		padding-bottom: 0.05rem;
	}
	.facet em {
		font-style: normal;
		color: rgb(var(--gray));
		font-size: 0.75rem;
	}

	.empty {
		margin: 1.5rem 0 0;
		color: rgb(var(--gray));
	}

	.legend {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid rgba(90, 112, 138, 0.16);
	}
	.legend summary {
		cursor: pointer;
		font-family: var(--font-display), sans-serif;
		font-weight: 700;
		color: var(--ink);
	}
	.dim-legend {
		margin: 0.85rem 0 0;
		padding-left: 1.1rem;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.dim-legend strong {
		color: var(--ink-soft);
	}
	.nested-title {
		margin-top: 1.25rem;
	}

	.reveal {
		opacity: 0;
		transform: translateY(12px);
		animation: rise 0.85s ease both;
	}
	.delay-1 {
		animation-delay: 0.12s;
	}
	.delay-2 {
		animation-delay: 0.24s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@keyframes draw-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 0.78;
		}
	}

	@media (max-width: 860px) {
		.layout {
			grid-template-columns: 1fr;
		}
		.filters {
			position: static;
			max-height: none;
			overflow: visible;
		}
		.matrix :global(.axis-label) {
			font-size: 7px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-mark,
		.reveal,
		.profile,
		.matrix :global(.trace) {
			animation: none !important;
			opacity: 1 !important;
			transform: none !important;
		}
	}
</style>
