---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SECTIONS, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<p class="brand-mark">{SITE_TITLE}</p>
				<h1 class="reveal">写给自己的蓝调笔记</h1>
				<p class="lede reveal delay-1">
					{SITE_TITLE} 的个人站点 — 想法、材料、作品，慢慢沉淀成歌。
				</p>
				<div class="hero-cta reveal delay-2">
					<a class="btn primary" href="/thoughts/">先读思考</a>
					<a class="btn ghost" href="/about/">关于我</a>
				</div>
			</section>

			<section class="paths reveal delay-3" aria-label="站点分区">
				<p class="paths-label">四个角落</p>
				<ul>
					{
						SECTIONS.map((section) => (
							<li>
								<a href={section.href}>
									<span class="path-name">{section.label}</span>
									<span class="path-blurb">{section.blurb}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: min(720px, calc(100% - 2em));
		padding-block: 2.5rem 3.5rem;
	}

	.hero {
		width: 100%;
		min-height: calc(100vh - 14rem);
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-bottom: 2.5rem;
	}

	.brand-mark {
		margin: 0 0 1rem;
		font-family: var(--font-display), sans-serif;
		font-size: clamp(2.6rem, 9vw, 4.4rem);
		font-weight: 800;
		letter-spacing: -0.045em;
		line-height: 0.95;
		color: var(--ink);
		animation: rise 0.9s ease both;
	}

	.hero h1 {
		margin: 0 0 0.85rem;
		font-size: clamp(1.35rem, 3.4vw, 1.85rem);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--ink-soft);
		max-width: 16ch;
	}

	.lede {
		margin: 0 0 2rem;
		max-width: 34ch;
		font-size: 1.12rem;
		color: rgb(var(--gray));
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.7rem 1.25rem;
		border-radius: 4px;
		text-decoration: none;
		font-family: var(--font-display), sans-serif;
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: -0.01em;
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.btn:hover {
		transform: translateY(-1px);
	}

	.btn.primary {
		background: var(--ink);
		color: #f4f8fb;
		border: 1px solid var(--ink);
	}
	.btn.primary:hover {
		background: var(--foam-deep);
		border-color: var(--foam-deep);
		color: #fff;
	}

	.btn.ghost {
		background: transparent;
		color: var(--ink);
		border: 1px solid rgba(28, 45, 69, 0.28);
	}
	.btn.ghost:hover {
		border-color: var(--foam);
		color: var(--foam-deep);
	}

	.paths {
		padding-top: 0.5rem;
		border-top: 1px solid rgba(90, 112, 138, 0.18);
	}

	.paths-label {
		margin: 0 0 1.25rem;
		font-family: var(--font-display), sans-serif;
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--foam-deep);
	}

	.paths ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.paths li a {
		display: grid;
		gap: 0.25rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid rgba(90, 112, 138, 0.14);
		text-decoration: none;
		color: inherit;
		transition: color 0.2s ease;
	}

	.paths li:first-child a {
		padding-top: 0.25rem;
	}

	.paths li a:hover .path-name {
		color: var(--foam-deep);
	}

	.path-name {
		font-family: var(--font-display), sans-serif;
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.path-blurb {
		font-size: 1rem;
		color: rgb(var(--gray));
		max-width: 36ch;
	}

	.reveal {
		opacity: 0;
		transform: translateY(12px);
		animation: rise 0.85s ease both;
	}
	.delay-1 {
		animation-delay: 0.12s;
	}
	.delay-2 {
		animation-delay: 0.24s;
	}
	.delay-3 {
		animation-delay: 0.36s;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 560px) {
		.hero {
			min-height: calc(100vh - 11rem);
			justify-content: flex-end;
			padding-bottom: 2rem;
		}
		.lede,
		.path-blurb {
			max-width: none;
		}
	}
</style>
