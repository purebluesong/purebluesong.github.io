---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const normalizedPath = pathname.endsWith('/') || pathname === '' ? pathname : `${pathname}/`;
const normalizedHref =
	typeof href === 'string'
		? href === '/'
			? '/'
			: href.endsWith('/')
				? href
				: `${href}/`
		: href;
const hrefPath =
	typeof normalizedHref === 'string' ? normalizedHref.replace(import.meta.env.BASE_URL, '') : '';
const isHome = hrefPath === '/' || hrefPath === '';
const isActive = isHome
	? normalizedPath === '/' || normalizedPath === ''
	: normalizedPath === hrefPath || normalizedPath.startsWith(hrefPath);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: 700;
	}
</style>
